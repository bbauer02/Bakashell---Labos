#!/bin/bash
# Seul accès de l'étudiant au moteur Docker (via sudo) : ouvrir un terminal sur une machine du réseau, y lancer une
# commande, ou la redémarrer. Les machines autorisées sont celles de /etc/reseau/machines.
#   lab-machine connexion <machine> [commande…]
#   lab-machine redemarrer <machine>
set -u
LISTE=/etc/reseau/machines
action=${1:-}
m=${2:-}
if [ -z "$m" ] || ! grep -qxF -- "$m" "$LISTE" 2>/dev/null; then
    echo "Machine inconnue : « $m »." >&2
    echo "Machines du réseau : $(paste -sd' ' "$LISTE" 2>/dev/null) (commande plan : le schéma)" >&2
    exit 1
fi
shift 2
# Couleur de la machine (invite et onglet de la page du labo) : selon son rang dans la liste, comme dans la page
COULEURS=("248;113;113" "251;191;36" "192;132;252" "96;165;250" "244;114;182" "251;146;60" "163;230;53" "232;121;249")
rang=$(grep -nxF -- "$m" "$LISTE" | head -n 1 | cut -d: -f1)
couleur=${COULEURS[$(( (rang - 1) % ${#COULEURS[@]} ))]}
case $action in
    connexion)
        opts=(-w /root -e "LAB_COULEUR=$couleur")
        if [ -t 0 ]; then opts+=(-it -e "TERM=${TERM:-xterm}"); else opts+=(-i); fi
        if [ $# -eq 0 ]; then
            exec docker exec "${opts[@]}" "$m" bash -l
        fi
        exec docker exec "${opts[@]}" "$m" bash -lc "$*"
        ;;
    redemarrer)
        echo "Redémarrage de $m…"
        docker restart -t 1 "$m" > /dev/null || exit 1
        /usr/local/sbin/lab-cablage
        # Noté à l'abri de l'étudiant (/var/lib/lab) : les vérifications savent qu'il a redémarré la machine
        echo "$m $(date +%s)" >> /var/lib/lab/redemarrages
        echo "$m a redémarré."
        ;;
    *)
        echo "Action inconnue : $action" >&2
        exit 1
        ;;
esac
