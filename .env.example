# Copier ce fichier en .env (non versionné) puis adapter.
ADMIN_EMAIL=enseignant@exemple.fr
ADMIN_PASSWORD=choisissez-un-mot-de-passe-solide
ADMIN_FIRST=Prénom
ADMIN_LAST=Nom
IDLE_TIMEOUT=7200
COOKIE_SECURE=0
# Adresse publique de la plateforme, utilisée dans les liens transmis (réinitialisation du mot de passe,
# attestation). Vide : l'adresse par laquelle la page a été ouverte.
PUBLIC_URL=
# Fuseau horaire des échéances
TZ=Europe/Paris
# Parcours Docker : sysbox-runc (recommandé, Sysbox installé sur l'hôte) ou privileged (développement uniquement)
DOCKER_LAB_RUNTIME=sysbox-runc
# Sauvegarde automatique de la base dans ./backups : intervalle (heures) et nombre de copies gardées
BACKUP_HOURS=24
BACKUP_KEEP=14
# Part des points (%) à atteindre pour obtenir l'attestation de fin de parcours
CERTIFICATE_MIN_PCT=70
# Derrière un reverse proxy : son adresse IP (pour connaître l'IP réelle des étudiants). Si le proxy est un
# conteneur ou tourne sur l'hôte, c'est l'adresse vue par la plateforme (souvent la passerelle Docker, ex.
# 172.18.0.1). Ne jamais mettre * : l'en-tête X-Forwarded-For deviendrait falsifiable.
FORWARDED_ALLOW_IPS=127.0.0.1
# Adresse d'écoute du port 8080 sur l'hôte : 127.0.0.1 derrière le reverse proxy HTTPS (port fermé à l'extérieur)
PLATFORM_BIND=0.0.0.0
# Envoi d'e-mails : lien d'activation des comptes enseignants créés avec une adresse académique (@ac-….fr).
# Sans SMTP_HOST, la plateforme n'envoie rien et les enseignants s'inscrivent uniquement par invitation.
# Brevo : SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, identifiant et clé SMTP fournis par Brevo.
# OVH (MX Plan) : SMTP_HOST=ssl0.ovh.net, SMTP_PORT=587 (465 est souvent bloqué en sortie, notamment chez Hetzner),
# l'adresse et le mot de passe de la boîte.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Bakashell <noreply@exemple.fr>
# Domaines autorisés à créer seuls un compte enseignant, séparés par des virgules (vide : les domaines des
# académies, ac-lyon.fr, ac-normandie.fr… ; « aucun » : inscription par invitation seulement)
TEACHER_SIGNUP_DOMAINS=
